      "name": "App",
      "item": [
        {
          "name": "Get Welcome Message",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access-token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{election-eye-base-url}}/"
          }
        },
